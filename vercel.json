{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @workspace/fashion-xpress run build && pnpm --filter @workspace/api-server run build",
  "outputDirectory": "artifacts/fashion-xpress/dist/public",
  "functions": {
    "api/index.cjs": {
      "includeFiles": "artifacts/api-server/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
