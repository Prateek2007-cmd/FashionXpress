{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_API_URL=https://fashionxpress.onrender.com pnpm --filter @workspace/fashion-xpress run build",
  "outputDirectory": "artifacts/fashion-xpress/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
